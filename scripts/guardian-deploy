#!/usr/bin/env bash
# Forced command for the guardian_deploy SSH key. Install on the sandbox EC2 at
# /usr/local/bin/guardian-deploy and pin the key to it in authorized_keys:
#
#   restrict,command="/usr/local/bin/guardian-deploy" ssh-ed25519 AAAA... guardian deploy
#
# The key can run this script and nothing else, so a leaked key cannot become a
# shell on a box that also hosts Lunar Melee prod. Same pattern as the
# lunar_prod key, which is pinned to lm-dev-dump.
#
# Usage from a dev machine (see the guardian-deploy Host in ~/.ssh/config):
#   ssh guardian-deploy            # defaults to deploy
#   ssh guardian-deploy status
#   ssh guardian-deploy logs
#   ssh guardian-deploy health
set -euo pipefail

REPO="${GUARDIAN_REPO:-/root/Projects/jungle_guardian}"
SERVICE="${GUARDIAN_SERVICE:-jungle-guardian}"

read -ra _argv <<< "${SSH_ORIGINAL_COMMAND:-deploy}"
CMD="${_argv[0]:-deploy}"

_gate_port() { grep -oP '^VOICE_GATE_PORT=\K.*' "$REPO/.env" 2>/dev/null || echo 8787; }
_gate_token() { grep -oP '^VOICE_GATE_TOKEN=\K.*' "$REPO/.env" 2>/dev/null; }

case "$CMD" in
  deploy)
    cd "$REPO"
    # Deploy target: the remote is authoritative. .env, score.json and the venv
    # are gitignored, so they survive the reset.
    git fetch --quiet origin main
    echo "deploying $(git rev-parse --short origin/main): $(git log -1 --format=%s origin/main)"
    git reset --hard --quiet origin/main
    # Refresh this script from the repo. Not a weakening of the restriction:
    # deploy already runs repo code as root (bot.py), so the repo is trusted
    # root-equivalent either way. A leaked key still cannot escalate, because
    # changing the forced command requires push access, not just the key.
    if ! cmp -s "$REPO/scripts/guardian-deploy" /usr/local/bin/guardian-deploy; then
      install -m 755 "$REPO/scripts/guardian-deploy" /usr/local/bin/guardian-deploy
      echo "refreshed forced command"
    fi
    "$REPO/.venv/bin/pip" install --quiet --upgrade -r "$REPO/requirements.txt"
    systemctl restart "$SERVICE"
    sleep 3
    systemctl is-active "$SERVICE"
    ;;
  status)
    systemctl status --no-pager --lines=0 "$SERVICE"
    ;;
  logs)
    # The unit sends the bot's own output to guardian.log (StandardOutput=append),
    # so journald holds only systemd lifecycle lines. Prefer the real log.
    if [ -f "$REPO/guardian.log" ]; then
      tail -n 60 "$REPO/guardian.log"
    else
      journalctl -u "$SERVICE" -n 60 --no-pager
    fi
    ;;
  units)
    journalctl -u "$SERVICE" -n 30 --no-pager
    ;;
  health)
    curl -sS --max-time 5 "http://127.0.0.1:$(_gate_port)/health" && echo
    ;;
  gate)
    # gate <channel_id> <user_id> <true|false> -- drives /voice/state the way the
    # site will, for testing against a real voice channel. No new authority: this
    # key can already deploy arbitrary repo code as root.
    cid="${_argv[1]:-}"; uid="${_argv[2]:-}"; muted="${_argv[3]:-}"
    [[ "$cid"   =~ ^[0-9]+$ ]]      || { echo "usage: gate <channel_id> <user_id> <true|false>" >&2; exit 2; }
    [[ "$uid"   =~ ^[0-9]+$ ]]      || { echo "usage: gate <channel_id> <user_id> <true|false>" >&2; exit 2; }
    [[ "$muted" =~ ^(true|false)$ ]] || { echo "usage: gate <channel_id> <user_id> <true|false>" >&2; exit 2; }
    curl -sS --max-time 10 -X POST "http://127.0.0.1:$(_gate_port)/voice/state" \
      -H "Authorization: Bearer $(_gate_token)" \
      -H 'Content-Type: application/json' \
      -d "{\"channel_id\":\"$cid\",\"updates\":[{\"user_id\":\"$uid\",\"muted\":$muted}],\"reason\":\"manual test\"}" \
      && echo
    ;;
  clear)
    # clear [channel_id] -- end-of-event path; omit the id to clear everything.
    cid="${_argv[1]:-}"
    if [[ -n "$cid" ]]; then
      [[ "$cid" =~ ^[0-9]+$ ]] || { echo "usage: clear [channel_id]" >&2; exit 2; }
      body="{\"channel_id\":\"$cid\",\"reason\":\"manual test clear\"}"
    else
      body='{"reason":"manual test clear"}'
    fi
    curl -sS --max-time 10 -X POST "http://127.0.0.1:$(_gate_port)/voice/clear" \
      -H "Authorization: Bearer $(_gate_token)" \
      -H 'Content-Type: application/json' -d "$body" && echo
    ;;
  *)
    echo "guardian-deploy: allowed commands are deploy | status | logs | units | health | gate | clear" >&2
    exit 2
    ;;
esac
